common --enable_platform_specific_config

# On macOS, make rules_docker's puller use an anonymous, credential-helper-free
# docker client config when fetching the base image. Without this, the puller
# reads ~/.docker/config.json and shells out to the configured credential
# helper (docker-credential-desktop) even for anonymous pulls of public
# images, which can hang and time out the container_pull fetch.
# Linux (CI) is left alone so the puller can use the docker/login-action
# credentials for higher Docker Hub rate limits.
build:macos --repo_env=DOCKER_CONFIG=%workspace%/third_party/docker_anon_config
